module bt5(
    input [3:0] SW,
    output reg [6:0] HEX1, HEX0
);
    always (*)
	 begin
		case (SW)
			4'b0000:
			4'b0001:
			4'b0010:
			4'b0011:
			4'b0100:
			4'b0101:
			4'b0110:
			4'b0111:
			4'b0000:
			4'b0001:
			4'b1010:
			4'b1011:
			4'b1100:
			4'b1101:
			4'b1110:
			4'b1111:
endmodule