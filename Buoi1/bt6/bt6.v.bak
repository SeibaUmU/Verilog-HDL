module bt6(SW,LEDR);
input [4:0]SW;
output reg [1:0]LEDR;
always @(SW)
begin
		case (SW)
            5'd2,  5'd3,  5'd5,  5'd7, 
            5'd11, 5'd13, 5'd17, 5'd19, 
            5'd23, 5'd29, 5'd31: 
                LEDR[1] = 1'b1; 
            
            default: 
                LEDR[1] = 1'b0; 
        endcase
end
endmodule
