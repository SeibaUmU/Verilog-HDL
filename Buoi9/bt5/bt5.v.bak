module bt5(SW, HEX0, HEX1, HEX2, HEX3, CLOCK_50, KEY0);
input [2:0]SW;
input CLOCK_50;
input KEY0;
output [6:0]HEX0, HEX1, HEX2, HEX3;
parameter s0 = 3'b000;
parameter s1 = 3'b001;
parameter s2 = 3'b010;
parameter s3 = 3'b011;
parameter s4 = 3'b100;
reg [2:0]cs, ns;
integer q = 0;
reg clock_1s = 0;
reg [3:0] bcd3, bcd2, bcd1, bcd0;
reg y;
	always @(posedge CLOCK_50) 
		begin
        if (q == 12499999) 
			begin
            q <= 0;
            clock_1s <= ~clock_1s;
			end 
		  else 
			q <= q + 1;
		end
	always @(*)
		begin
			case (cs)
				s0: ns = s1;
				s1: ns = s2;
				s2: ns = s3;
				s3: ns = s4;
				s4: ns = s0;
				default: ns = s0;
			endcase
		end
	always @(posedge clock_1s)
		begin
			if (!KEY0) cs <= s0;
			else cs <= ns;
		end
	always @(*)
		begin
			case (cs)
				s0:
					begin
						bcd3 = 4'd3;
						bcd2 = 4'd3;
						bcd1 = 4'd3;
						bcd0 = 4'd3;
					end
				s1:
					begin
						bcd3 = 4'd2;
						bcd2 = 4'd3;
						bcd1 = 4'd3;
						bcd0 = 4'd3;
					end
				s2:
					begin
						bcd3 = 4'd1;
						bcd2 = 4'd2;
						bcd1 = 4'd3;
						bcd0 = 4'd3;
					end
				s3:
					begin
						bcd3 = 4'd1;
						bcd2 = 4'd1;
						bcd1 = 4'd2;
						bcd0 = 4'd3;
					end
				s4:
					begin
						bcd3 = 4'd0;
						bcd2 = 4'd1;
						bcd1 = 4'd1;
						bcd0 = 4'd2;
					end
				default:
					begin
						bcd3 = 4'd3;
						bcd2 = 4'd3;
						bcd1 = 4'd3;
						bcd0 = 4'd3;
					end
			endcase
		end
	led_7doan u1(bcd3, HEX3);
	led_7doan u2(bcd2, HEX2);
	led_7doan u3(bcd1, HEX1);
	led_7doan u4(bcd0, HEX0);
endmodule

module led_7doan(BCD, LED);
    input  [3:0] BCD;
    output reg [6:0] LED;
    always @(*) 
		begin
        case(BCD)
            4'd0: LED = 7'b1000010;
            4'd1: LED = 7'b0100011;
            4'd2: LED = 7'b0100001;
            default: LED = 7'b1111111;
        endcase
		end
endmodule